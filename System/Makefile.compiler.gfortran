#==== gfortran (tested: gcc 12+) ====
FC = gfortran
#FC = mpif90

#-- opt or debug
FCFLAGS = -O3
#FCFLAGS = -g -O0 -Wall -fcheck=all
#-- gfortran 4.4.3 debug flags:
#FCFLAGS = -g -O0 -Wall -fbounds-check -fbacktrace

#-- legacy-source compatibility (gfortran >= 10)
FCFLAGS += -std=legacy -fallow-argument-mismatch

#-- additional flags
FCFLAGS += -m64 -msse3
FCFLAGS += -fopenmp
FCFLAGS_FF = -ffixed-form
LDFLAGS = -fopenmp -llapack -lblas

AR = ar
RANLIB=ranlib
